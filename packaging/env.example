# Environment for the TasksPending daemon: copy to
# ~/.config/tasks-pending/env and `chmod 600` it. One KEY=value per line, no
# `export`, no quotes needed. Only set what your config uses.

# GitHub (else GITHUB_TOKEN / GH_TOKEN, else `gh auth token`)
# GITHUB_TOKEN=

# GitLab (personal access token with the read_api scope; the base URL only
# for a self-managed instance)
# GITLAB_TOKEN=
# GITLAB_BASE_URL=https://gitlab.example.com

# Plane
# PLANE_BASE_URL=https://plane.example.com
# PLANE_WORKSPACE=
# PLANE_TOKEN=

# Jira Cloud: the site address, your e-mail and an API token.
# Jira Data Center: the address and JIRA_TOKEN (personal access token) alone.
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_TOKEN=

# Todoist
# TODOIST_API_TOKEN=

# iCal feed URL. Treat this URL as a secret.
# TASKS_PENDING_ICAL_URL=
