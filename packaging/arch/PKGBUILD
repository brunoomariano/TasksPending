# Maintainer: Bruno Mariano
# Binary package built from the release bundle. The release workflow fills in
# pkgver and the checksum and builds it with the bundle next to this file.
pkgname=tasks-pending-bin
pkgver=0.6.0
pkgrel=1
pkgdesc="Local-first desktop dashboard of pending work (GitHub, GitLab, Jira, Linear, Plane, calendars, Todoist): a GTK4 window and its daemon"
arch=('x86_64')
url="https://github.com/brunoomariano/TasksPending"
license=('MIT')
depends=('glibc' 'gcc-libs' 'gtk4' 'libadwaita' 'hicolor-icon-theme')
optdepends=(
  'github-cli: GitHub token from `gh auth token`'
  'gnome-online-accounts: Google Calendar source'
)
provides=('tasks-pending')
conflicts=('tasks-pending')
# Prebuilt release binaries: no separate debug package.
options=('!debug')
_bundle="tasks-pending-$pkgver-x86_64-unknown-linux-gnu"
source=("$_bundle.tar.gz::$url/releases/download/v$pkgver/$_bundle.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$_bundle"
  PREFIX=/usr DESTDIR="$pkgdir" ./scripts/install.sh
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -d "$pkgdir/usr/share/doc/tasks-pending"
  install -m644 README.md CHANGELOG.md docs/install.md docs/operations.md \
    "$pkgdir/usr/share/doc/tasks-pending/"
}
